# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# --- Core (required) ---
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/phonepe-clone
JWT_SECRET=change_this_to_a_long_random_string

# development | production | test
NODE_ENV=development

# --- Running behind a reverse proxy / load balancer ---
# Number of proxy hops in front of this app. 0 = exposed directly,
# 1 = behind one nginx (what docker-compose sets).
#
# This is a SECURITY setting. Leave it at 0 when there's no proxy: the per-IP
# rate limiters would otherwise trust a client-supplied X-Forwarded-For and
# let anyone pick their own rate-limit bucket. Never set it to `true`.
TRUST_PROXY_HOPS=0

# Identifies this replica in logs and in the X-Instance-Id response header.
# Defaults to the hostname.
# INSTANCE_ID=api-1

# --- MongoDB transactions ---
# auto (default): detect whether the deployment is a replica set and use real
#   ACID transactions if so, otherwise fall back to atomic $inc + compensating
#   writes. `docker compose up` gives you a single-node replica set.
# on / off: force either behaviour.
MONGO_TRANSACTIONS=auto

# --- Redis ---
# Powers caching, rate-limit counters, the JWT blacklist, idempotency keys,
# and the notification queue.
#
# Optional for a single instance (everything degrades to an in-memory
# fallback). EFFECTIVELY REQUIRED once you run more than one replica: the
# fallbacks are per-process, so a token revoked on one instance would stay
# valid on the others.
# REDIS_URL=redis://127.0.0.1:6379

# --- Notification queue (BullMQ) ---
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_MS=2000
QUEUE_CONCURRENCY=5

# --- SMTP (for OTP emails and transaction notifications) ---
# Gmail example (create an App Password at myaccount.google.com/apppasswords):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_16_char_app_password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PhonePe Clone <no-reply@phonepeclone.com>"

# --- SMTP circuit breaker ---
# After this many consecutive failures we stop calling SMTP entirely for
# SMTP_BREAKER_RESET_MS, then let one probe through to test recovery.
SMTP_BREAKER_FAILURES=3
SMTP_BREAKER_RESET_MS=60000
SMTP_TIMEOUT_MS=10000

# --- Money / limits (rupees) ---
OPENING_BALANCE_RUPEES=1000
LIMIT_PER_TRANSACTION=100000
LIMIT_DAILY=100000
LIMIT_MONTHLY=1000000
LIMIT_DAILY_COUNT=20
MAX_PAGE_SIZE=100

# --- MPIN lockout ---
MPIN_MAX_ATTEMPTS=5
MPIN_LOCK_SECONDS=900

# --- Background worker ---
# Cron expression for the autopay scheduler (default: every 5 minutes)
RECURRING_CRON=*/5 * * * *
RECURRING_MAX_FAILURES=3
# true on API replicas (background work belongs to worker.js), false on the worker
DISABLE_WORKER=false

# --- Logging ---
# trace | debug | info | warn | error | silent
LOG_LEVEL=info
