{
  "name": "phonepe-backend-clone",
  "version": "2.0.0",
  "description": "A PhonePe backend clone with a double-entry ledger, integer-paise money handling, and production-readiness features",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "swagger": "node swagger.js",
    "seed": "node seed.js",
    "migrate": "node scripts/migrate-to-paise.js",
    "reconcile": "node scripts/reconcile.js",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:queue": "jest --selectProjects queue --runInBand",
    "postman": "node scripts/generate-postman.js",
    "docs": "npm run swagger && npm run postman"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.4",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.0",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.1",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  }
}
